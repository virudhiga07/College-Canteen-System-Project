digraph ClassDiagram {
 graph [rankdir=LR, bgcolor="#F7F9FC", pad="0.35", nodesep="0.48", ranksep="0.9", splines=polyline,
        labelloc=t, label="VCET COLLEGE CANTEEN\nUML CLASS DIAGRAM", fontname="DejaVu Sans", fontsize=24, fontcolor="#17324D"];
 node [shape=plain, fontname="DejaVu Sans"];
 edge [color="#526A82", penwidth=1.8, arrowsize=0.8, fontname="DejaVu Sans", fontsize=10, fontcolor="#425A72"];
 Main [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#315D82" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#244C70"><FONT COLOR="white" POINT-SIZE="16"><B>Main</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- sc : Scanner {static}</FONT></TD></TR><TR><TD BGCOLOR="#EAF2FA"><FONT POINT-SIZE="10"><B>Operations</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ main(args) : void</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- addFood() / viewFood()</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- updateFood() / deleteFood()</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- placeOrder() / viewPreviousBill()</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- printReceipt() : void</FONT></TD></TR></TABLE> >];
 FoodDAO [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#315D82" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#244C70"><FONT COLOR="white" POINT-SIZE="16"><B>FoodDAO</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">(No persistent attributes)</FONT></TD></TR><TR><TD BGCOLOR="#EAF2FA"><FONT POINT-SIZE="10"><B>Operations</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ addFood(...) : int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ getAllFood() : List&lt;FoodItem&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ updateFood(...) : int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ deleteFood(id) : int</FONT></TD></TR></TABLE> >];
 FoodItem [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#315D82" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#244C70"><FONT COLOR="white" POINT-SIZE="16"><B>FoodItem</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- foodId : int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- foodName : String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- category : String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- price : BigDecimal</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- stockQuantity : int</FONT></TD></TR><TR><TD BGCOLOR="#EAF2FA"><FONT POINT-SIZE="10"><B>Operations</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ FoodItem(...)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ getters : values</FONT></TD></TR></TABLE> >];
 OrderDAO [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#315D82" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#244C70"><FONT COLOR="white" POINT-SIZE="16"><B>OrderDAO</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">(No persistent attributes)</FONT></TD></TR><TR><TD BGCOLOR="#EAF2FA"><FONT POINT-SIZE="10"><B>Operations</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ placeOrder(items) : OrderResult</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ getOrderById(id) : OrderResult</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- OrderLine (nested helper)</FONT></TD></TR></TABLE> >];
 OrderResult [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#315D82" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#244C70"><FONT COLOR="white" POINT-SIZE="16"><B>OrderResult</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- orderId : int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- orderDate : Timestamp</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- totalAmount : BigDecimal</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- items : List&lt;BillItem&gt;</FONT></TD></TR><TR><TD BGCOLOR="#EAF2FA"><FONT POINT-SIZE="10"><B>Operations</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ getters()</FONT></TD></TR></TABLE> >];
 BillItem [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#527A9B" BGCOLOR="#F8FBFE"><TR><TD BGCOLOR="#527A9B"><FONT COLOR="white" POINT-SIZE="14"><B>BillItem (nested)</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- foodName : String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- quantity : int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- unitPrice : BigDecimal</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- subtotal : BigDecimal</FONT></TD></TR><TR><TD BGCOLOR="#EAF2FA"><FONT POINT-SIZE="10"><B>Operations</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ getters()</FONT></TD></TR></TABLE> >];
 SalesReportDAO [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#315D82" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#244C70"><FONT COLOR="white" POINT-SIZE="16"><B>SalesReportDAO</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">(No persistent attributes)</FONT></TD></TR><TR><TD BGCOLOR="#EAF2FA"><FONT POINT-SIZE="10"><B>Operations</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ displaySalesReport() : void</FONT></TD></TR></TABLE> >];
 DatabaseConnection [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8D6A35" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#8D6A35"><FONT COLOR="white" POINT-SIZE="16"><B>DatabaseConnection</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- URL : String {static final}</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- USER : String {static final}</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- PASSWORD : String {static final}</FONT></TD></TR><TR><TD BGCOLOR="#F7F0E5"><FONT POINT-SIZE="10"><B>Operations</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- DatabaseConnection()</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ getConnection() : Connection</FONT></TD></TR></TABLE> >];
 {rank=same; FoodDAO; OrderDAO; SalesReportDAO;}
 Main -> FoodDAO [label="uses"];
 Main -> OrderDAO [label="uses"];
 Main -> SalesReportDAO [label="uses"];
 FoodDAO -> FoodItem [label="creates / returns"];
 OrderDAO -> OrderResult [label="creates / returns"];
 OrderResult -> BillItem [label="contains", arrowhead=diamond];
 FoodDAO -> DatabaseConnection [style=dashed, label="depends on"];
 OrderDAO -> DatabaseConnection [style=dashed, label="depends on"];
 SalesReportDAO -> DatabaseConnection [style=dashed, label="depends on"];
}